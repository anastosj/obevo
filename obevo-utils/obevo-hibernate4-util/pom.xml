<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>obevo-utils</artifactId>
        <groupId>com.goldmansachs.obevo</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>obevo-hibernate4-util</artifactId>
    <name>${project.artifactId}</name>

    <properties>
        <jacoco.minCoverage>0.70</jacoco.minCoverage>
        <hibernate.version>4.3.11.Final</hibernate.version>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The java18 signature check applies to Java 8 modules only -->
        <animal.sniffer.skip>true</animal.sniffer.skip>
        <!-- The repo-wide Kotlin 1.3.61 compiler cannot emit JVM target 17 -->
        <kotlin.jvm17.version>1.9.25</kotlin.jvm17.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.jvm17.version}</version>
                <configuration>
                    <jvmTarget>${maven.compiler.release}</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 3.5.1 (repo-wide) predates the <release> option -->
                <version>3.10.1</version>
                <configuration>
                    <source combine.self="override">${maven.compiler.release}</source>
                    <target combine.self="override">${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.goldmansachs.obevo</groupId>
            <artifactId>obevo-hibernate-util</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.goldmansachs.obevo</groupId>
            <artifactId>obevo-hibernate-util</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.goldmansachs.obevo</groupId>
            <artifactId>obevo-core</artifactId>
            <version>${project.version}</version>
            <classifier>tests</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <optional>true</optional>
            <!-- This would be directly in the client project. The client should already have the dependency defined -->
        </dependency>
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-envers</artifactId>
            <version>${hibernate.version}</version>
            <optional>true</optional>
            <!-- This would be directly in the client project. The client should already have the dependency defined -->
        </dependency>
        <dependency>
            <!-- This is only needed to get the reverse engineering classes out -->
            <groupId>com.goldmansachs.obevo</groupId>
            <artifactId>obevo-db-db2</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>